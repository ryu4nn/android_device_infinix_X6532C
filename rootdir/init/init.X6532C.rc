#
# init.X6532C.rc — Infinix Smart 9 HD (X6532C)
#
# Device-specific system services only. All MediaTek hardware services live in
# the vendor partition and are started by vendor/etc/init/hw/init.mt6765.rc.
# Keep this file deliberately small; add services here only when a service is
# provided by the device tree (system) rather than by the vendor blobs.
#

on early-init
    # Reserve /data/media ownership for the FBE media provider
    mkdir /data/media 0770 media_rw media_rw

on boot
    # Device bring-up hooks go here (sensors, input, display calibration, ...).

# Touch gestures, touch game mode and the panel refresh default.
#
# The Transsion nodes (/proc/gesture_function, /proc/game_state) only exist
# once the touch and display modules have probed, so this runs after
# boot_completed and the script itself waits up to 30 s for the node. It runs
# in x6532c_boot, a device-owned domain (sepolicy/x6532c_boot.te).
on property:sys.boot_completed=1
    exec_background u:r:x6532c_boot:s0 root -- /system/bin/x6532c-boot.sh